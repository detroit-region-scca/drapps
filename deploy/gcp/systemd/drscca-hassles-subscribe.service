[Unit]
OnFailure=drscca-alert@%n.service
Description=DRSCCA apps: add or remove Hassles subscribers on hassles@drscca.org (that group only)
[Service]
Type=oneshot
# A job stuck this long is stopped and counts as failed, so the alert email goes out.
TimeoutStartSec=10min
WorkingDirectory=/opt/drscca/app
Environment=GAM=/opt/drscca/venv/bin/gam
Environment=GAMCFGDIR=/opt/drscca/data/secrets/gam
ExecStart=/opt/drscca/venv/bin/python tools/hassles_subscribe.py
