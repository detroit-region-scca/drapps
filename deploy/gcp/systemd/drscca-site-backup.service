[Unit]
Description=DRSCCA apps: weekly copy of the drscca.org website's content to the region shared drive
OnFailure=drscca-alert@%n.service
[Service]
Type=oneshot
# REGION_DRIVE_ID, when set in drapps.env.
EnvironmentFile=-/opt/drscca/data/secrets/drapps.env
ExecStart=/opt/drscca/venv/bin/python /opt/drscca/app/deploy/gcp/site_backup.py
