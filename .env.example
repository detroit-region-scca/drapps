# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Region ---
SCCA_REGION_ACRONYM="DRSCCA"
SCCA_REGION_NAME="Detroit Region SCCA"
EVENT_CODE_PREFIX="DR"
PROGRAM_DIRECTORS_TEXT="For use by DRSCCA program directors"
TIMEZONE=US/Eastern
PROGRAMS_FILE=data/programs.json

# --- Web ---
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
PORT=5858
HOST=0.0.0.0
DEBUG=False

# --- Data: Google Sheets in the DRSCCA Apps Shared Drive ---
STORAGE_BACKEND=sheets
# Path of the service account key ON THE HOST, for the host jobs (tools/, deploy/gcp/alert.py). On the drapps VM
# the job units set it; deploy/gcp/docker-compose.yml mounts the same file into the container.
GOOGLE_SA_KEY_HOST=/path/to/google-sa.json
# Path INSIDE the container (leave as is with deploy/gcp/docker-compose.yml)
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
# Spreadsheet and folder IDs: the long ID in each Google URL
REGISTRY_SHEET_ID=
BUDGETS_SHEET_ID=
BUDGETS_FILES_FOLDER_ID=
FUNDS_SHEET_ID=
FUNDS_RECEIPTS_FOLDER_ID=
PLAN_SHEET_ID=
OPERATIONS_SHEET_ID=
OPERATIONS_DOCS_FOLDER_URL=
INVOICES_SHEET_ID=
INVOICES_PDF_FOLDER_ID=
# Members and worker points (private sheet), the public sheet drscca.org reads, and the folder for member list exports
MEMBERS_SHEET_ID=
PUBLIC_SHEET_ID=
MEMBER_LISTS_FOLDER_ID=
# Board minutes: private originals, the public website folder (by year), and drafts
MINUTES_PRIVATE_FOLDER_ID=
MINUTES_PUBLIC_FOLDER_ID=
MINUTES_DRAFTS_FOLDER_ID=
# Records: Drive folder where anyone signed in drops new results files (Records > Add results), read in later
RESULTS_INBOX_FOLDER_ID=
# The public website, for links to drafts it publishes (default https://drscca.org)
WEBSITE_URL=https://drscca.org
# Local cache of the sheets so pages load fast (on by default; 0 turns it off). Checks Drive for changes every N seconds.
# SHEET_CACHE=1
# SHEET_CACHE_POLL_SECONDS=15

# --- Officials (who approves what); see officials.example.json ---
# Path ON THE HOST; deploy/gcp/docker-compose.yml mounts that file read-only. Admin > Users changes it through
# tools/officials_queue.py on the host.
OFFICIALS_HOST=/path/to/officials.json
# Days an emailed approval or vote link keeps working (default 7), and the votes that decide a board email vote (default 7)
# LINK_DAYS=7
# BOARD_VOTES_NEEDED=7
# Role groups the app emails (defaults shown)
# BOARD_EMAIL=bod@drscca.org
# MEMBERSHIP_EMAIL=membership@drscca.org

# --- Sign in with Google (optional; email codes always work) ---
# An OAuth web client in Google Cloud; its redirect URI is https://<your host>/signin/google/back
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Leave user and password empty only for a relay that accepts this host without login
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where replies go (e.g. a shared inbox group); optional
SMTP_REPLY_TO=
# Where new-event notices go, and the fallback treasurer address
NOTIFICATION_EMAIL=treasurer@drscca.org

# JSON API (/api/v1), see api.py: "email:key" pairs, comma separated. The email must be in the
# officials list; the key acts as that official. Make a key with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
API_KEYS=

# --- Email transport (choose one) ---
# SMTP: the SMTP_* settings above. Or the Gmail API as the service account, which needs no password on the server
# (domain-wide delegation, scope gmail.send). GMAIL_SENDER is the mailbox it sends from; SMTP_FROM must be a send-as
# address of it.
# MAIL_TRANSPORT=gmail_api
# GMAIL_SENDER=admin@example.org
# Text at the bottom of every email (optional)
# MAIL_FOOTER=

# --- Host tools (tools/handover.py, tools/officials_queue.py); defaults shown ---
# APP_CONTAINER=drapps
# GAM=~/.local/bin/gam
# GAMCFGDIR=~/.gam

# --- Server backups: the nightly off-site copy (deploy/gcp/offsite_backup.py) keeps its own settings in
# data/secrets/offsite-backup.env (RESTIC_REPOSITORY, RESTIC_PASSWORD, GOOGLE_APPLICATION_CREDENTIALS, GOOGLE_PROJECT_ID).
# The admin-only Account Recovery folder in the region shared drive, for the recovery sheet and code files (no job writes there)
# ACCOUNT_RECOVERY_FOLDER_ID=
# The DRSCCA Region shared drive (weekly website copies go to "Website Archive/Weekly site backups" in it)
# REGION_DRIVE_ID=
